# ============================================================
#  Figma連携の設定
#  このファイルをコピーして .env を作り、値を書き込んでください。
#      cp .env.example .env
#  .env は Git に含まれません（.gitignore 済み）。
# ============================================================

# Figma 個人アクセストークン（figd_ で始まる文字列）
#   取り方: Figma右上のアカウントメニュー → Settings → Security タブ
#           → Personal access tokens → Generate new token
#           スコープは「File content: Read」にチェック
FIGMA_TOKEN=

# 対象Figmaファイルのキー
#   FigmaのURLから取ります:
#   https://www.figma.com/design/【ここがFILE_KEY】/ファイル名
FIGMA_FILE_KEY=

# ---- 以下は任意（未設定なら既定値が使われます） ----

# 制作実績として書き出すページの名前（既定: HP掲載）
# FIGMA_WORKS_PAGE=HP掲載

# 書き出し倍率（既定: 2）／形式 png または jpg（既定: png）
# FIGMA_WORKS_SCALE=2
# FIGMA_WORKS_FORMAT=png
